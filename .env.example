# Bybit keys must have trading permission only. Never enable withdrawals.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Optional multimodal analysis provider. The bot can run without it.
OPENAI_API_KEY=
LLM_ENABLED=false
LLM_MODEL=gpt-5.6-luna

TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=60
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.30
MAX_LEVERAGE=3
DAILY_LOSS_LIMIT=0.03
MAX_OPEN_POSITIONS=3
LIVE_TRADING=false

